// Prisma 7: URL kết nối KHÔNG nằm ở đây nữa — nó ở prisma7.config.ts.
generator client {
  provider = "prisma-client" // generator ESM-first, sinh code TS thật
  output   = "../src/generated/prisma" // relative tới file schema này
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  username     String   @unique
  displayName  String
  avatarUrl    String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  members        Member[]
  messages       Message[]
  reactions      MessageReaction[]
  pinnedMessages Message[]         @relation("MessagePins")
  ownedServers   Server[]
  invites        ServerInvite[]
  // TG.11: ban — nạn nhân (bansReceived) và người ra lệnh (bansIssued).
  bansReceived   ServerBan[]       @relation("ServerBanTargets")
  bansIssued     ServerBan[]       @relation("ServerBanActors")
  // TG.9 (ADR-0070): mức nhận DM — 'server_members' mặc định (người chung server), 'none' tắt hẳn.
  // Kiểu String khớp cách `Attachment.scope` đặt tên nhánh pipeline; giá trị do API kiểm (zod).
  dmAllow            String          @default("server_members")
  dmParticipations   DmParticipant[]
  blocksIssued       UserBlock[]     @relation("UserBlocksIssued")
  blocksReceived     UserBlock[]     @relation("UserBlocksReceived")
  // TG.12: prefs thông báo của user (một dòng mỗi server/channel đã cấu hình).
  notificationPrefs  NotificationPref[]
  // TG.13: cài đặt giao diện/ngôn ngữ — một hàng mỗi user, tạo LAZY (chỉ PATCH mới upsert).
  settings           UserSettings?
  // TG.8: chính sách tài khoản chưa xác minh — chặn tạo server/mã mời cho tới khi
  // người dùng xác minh email. Default false: user mới chưa xác minh; seed gán true.
  emailVerified      Boolean @default(false)
  emailTokens        EmailToken[]
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  // Lookup refresh token theo hash phải là O(log n): mỗi request /refresh
  // tra bảng này. @unique cũng bất biến "mỗi token ứng đúng 1 session".
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  // TG.8: tóm tắt User-Agent cho danh sách phiên ("Chrome trên Windows") — tính MỘT lúc
  // tạo (hàm thuần describeUserAgent) để danh sách không phải parse UA mỗi lần đọc.
  // Hàng cũ trước TG.8 để '' và được suy lại từ userAgent khi đọc.
  device           String    @default("")
  // TG.8: lần dùng gần nhất — cập nhật mỗi lần refresh thành công, sắp xếp danh sách phiên.
  lastUsedAt       DateTime  @default(now())

  // Refresh token gắn với user: xóa user thì phiên đăng nhập phải chết theo.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// TG.8: token một lần cho xác minh email ('verify', TTL 24h) và đặt lại mật khẩu
/// ('reset', TTL 30 phút). DB chỉ giữ BĂM SHA-256 — token thô chỉ tồn tại trong thư;
/// dùng xong đánh dấu usedAt (một mã VERIFY_TOKEN_INVALID chung cho sai/hết hạn/đã dùng).
/// kind kiểu String (giá trị do API kiểm) khớp cách User.dmAllow/Attachment.scope đặt tên.
model EmailToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Server {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String
  iconUrl    String?
  ownerId    String   @db.Uuid
  // Mã mời rút gọn (guide 10.1 "tham gia bằng invite") — người chưa là member
  // vẫn join được khi có code này, không cần biết serverId.
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  // FK thật cho ownerId (guide chỉ để String trần): mặc định required relation
  // = Restrict — không thể xóa user đang sở hữu server, phải chuyển quyền trước.
  owner        User           @relation(fields: [ownerId], references: [id])
  members      Member[]
  roles        Role[]
  channels     Channel[]
  categories   ChannelCategory[]
  invites      ServerInvite[]
  stickerPacks StickerPack[]
  customEmojis CustomEmoji[]
  bans         ServerBan[]
}

// T3.6: mã mời là bản ghi riêng thay vì chỉ cột `inviteCode` trên Server, để
// regenerate vô hiệu mã cũ (revokedAt) và mã có hạn dùng (expiresAt). Cột
// `Server.inviteCode` giữ làm bản sao Denormalized của mã đang hoạt động để
// danh sách server/hiển thị không cần join; join (tham gia server) tra bảng này.
model ServerInvite {
  id          String    @id @default(uuid(7)) @db.Uuid
  serverId    String    @db.Uuid
  code        String    @unique
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?

  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // Tìm mã đang hoạt động của một server (hiển thị, regenerate revoke mã cũ).
  @@index([serverId, revokedAt])
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  serverId    String  @db.Uuid
  name        String
  // Bitmask 64-bit — các h bit của Permission trong @ping/shared được OR vào đây.
  permissions BigInt  @default(0)
  position    Int     @default(0)
  isDefault   Boolean @default(false) // role @everyone: tạo kèm khi tạo server

  server   Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members  MemberRole[]
  mentions MessageMention[]

  @@index([serverId])
}

model Member {
  id       String   @id @default(uuid(7)) @db.Uuid
  serverId String   @db.Uuid
  userId   String   @db.Uuid
  nickname String?
  joinedAt DateTime @default(now())

  server     Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles      MemberRole[]
  readStates ChannelReadState[]
  mentions   MessageMention[]

  // Một user chỉ là member đúng 1 lần mỗi server.
  @@unique([serverId, userId])
  // "Các server của tôi" — đếm nhanh không cần quét bảng Member.
  @@index([userId])
  // Phân trang cursor danh sách thành viên: WHERE serverId = ? AND id > ? ORDER BY id.
  @@index([serverId, id])
}

/// TG.11: lệnh cấm tham gia server. Tồn tại ĐỘC LẬP với Member — ban gỡ membership TRƯỚC
/// rồi mới tạo hàng ban, và hàng ban phải còn nguyên sau khi Member đã xóa để chặn join
/// lại bằng mã mời. Vì vậy KHÔNG FK tới Member (FK tới Member sẽ cascade/xóa theo).
model ServerBan {
  id         String   @id @default(uuid(7)) @db.Uuid
  serverId   String   @db.Uuid
  userId     String   @db.Uuid
  reason     String?
  bannedById String   @db.Uuid
  createdAt  DateTime @default(now())

  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  // Xóa tài khoản nạn nhân thì lệnh ban theo cũng vô nghĩa (user id không còn ai chiếm) — Cascade.
  user     User   @relation("ServerBanTargets", fields: [userId], references: [id], onDelete: Cascade)
  // Người ra lệnh phải còn nguyên trên dòng ban (hiện trong danh sách ban); mẫu
  // ServerInvite.createdBy: Restrict — xóa tài khoản phải xử lý ban trước (TG.8).
  bannedBy User   @relation("ServerBanActors", fields: [bannedById], references: [id])

  // Một user chỉ bị ban đúng 1 lần mỗi server (re-ban sau unban tạo hàng mới).
  @@unique([serverId, userId])
  // Join tra "tôi có bị ban ở server này không" theo đúng cặp (serverId, userId).
  // Danh sách ban của một server, mới nhất trước (phân trang cursor).
  @@index([serverId, id(sort: Desc)])
  // "Các server tôi bị ban" — tra ngược theo user không cần quét bảng.
  @@index([userId])
}

// Trạng thái đã đọc theo thành viên-kênh (T4.1, ADR-0043): một hàng cho mỗi
// (member, channel), ghi bởi T4.2; unread = đếm tin `id > lastReadMessageId` có trần.
model ChannelReadState {
  memberId          String   @db.Uuid
  channelId         String   @db.Uuid
  lastReadMessageId String?  @db.Uuid
  updatedAt         DateTime @updatedAt

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([memberId, channelId])
  // GET /servers/:id/unread quét mọi kênh của một thành viên (T4.2).
  @@index([memberId])
}

// Mention được parse khi tạo/sửa tin (T4.1, ADR-0043). Id surrogate + unique thay vì
// PK composite như plan 5.1 vì Postgres không cho cột NULL trong primary key; dedup do
// ứng dụng kiểm soát (parse ra tập duy nhất, sửa tin xoá rồi ghi lại).
model MessageMention {
  id                String  @id @default(uuid(7)) @db.Uuid
  messageId         String  @db.Uuid
  // NULL khi là @everyone / @role.
  mentionedMemberId String? @db.Uuid
  kind              String // "user" | "role" | "everyone"
  roleId            String? @db.Uuid

  message         Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedMember Member? @relation(fields: [mentionedMemberId], references: [id], onDelete: Cascade)
  role            Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([messageId, kind, mentionedMemberId, roleId])
  // Đếm mention mới cho một user (T4.2/T4.3): WHERE mentionedMemberId = ? AND messageId > ?.
  @@index([mentionedMemberId, messageId(sort: Desc)])
}

model MemberRole {
  memberId String @db.Uuid
  roleId   String @db.Uuid

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
}

model Channel {
  id        String      @id @default(uuid(7)) @db.Uuid
  // TG.9 (ADR-0070): NULL với channel DM — mọi query cũ lọc theo serverId nên DM vô hình
  // với instance cũ (rolling-safe, expand/contract).
  serverId  String?     @db.Uuid
  name      String
  type      ChannelType @default(TEXT)
  position  Int         @default(0)
  // TG.9: `"min|max"` hai UUID participant đã chuẩn hóa thứ tự — chìa khóa get-or-create
  // idempotent của POST /dms; hai request song song chạm unique này thì hàng sau trả existing.
  dmKey     String?     @unique
  // TG.10: category chứa channel; NULL = vùng mặc định (thứ tự theo `position` Int cũ).
  // onDelete: SetNull — xóa category PHẢI giữ nguyên channel (về vùng mặc định), tuyệt đối
  // không Cascade xóa kênh; API cũng tự đặt NULL trong cùng transaction (SetNull là lưới an toàn).
  categoryId  String?   @db.Uuid
  // TG.10: chủ đề hiển thị ở header channel.
  topic       String?
  // TG.10: thứ tự TRONG category (lexorank 'a'..'z' — packages/shared/src/lexorank.ts);
  // NULL khi ngoài category (thứ tự theo `position` Int). `position` cũ KHÔNG đụng: rolling-safe.
  positionKey String?

  createdAt DateTime    @default(now())

  server     Server?            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category   ChannelCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages   Message[]
  readStates ChannelReadState[]
  dmParticipants DmParticipant[]

  @@index([serverId])
  // Xóa category phải quét kênh thuộc nó (SetNull); list kênh của một nhóm cũng tra theo đây.
  @@index([categoryId])
}

/// Nhóm channel trong sidebar (TG.10). `position` là lexorank so sánh theo CHUỖI ('a' < 'aa'):
/// chèn giữa hai nhóm chỉ cập nhật một hàng, không đánh số lại hàng loạt — sinh rank bằng
/// packages/shared/src/lexorank.ts.
model ChannelCategory {
  id       String   @id @default(uuid(7)) @db.Uuid
  serverId String   @db.Uuid
  name     String
  position String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]

  // List category của server (GET detail) sắp theo vị trí; lock/tạo mới đọc max theo đây.
  @@index([serverId, position])
}

enum ChannelType {
  TEXT
  // TG.9 (ADR-0070): tin nhắn trực tiếp 1:1 ngoài server.
  DM
  // Mở rộng sau: VOICE, ANNOUNCEMENT...
}

/// Participant của channel DM (TG.9, ADR-0070): DM không có Member nên membership + con trỏ
/// đã đọc (ngữ nghĩa ADR-0043) đặt thẳng trên bảng này — một bảng cho cả quyền lẫn unread.
model DmParticipant {
  channelId         String   @db.Uuid
  userId            String   @db.Uuid
  lastReadMessageId String?  @db.Uuid
  // Mốc tạo hàng dùng làm bối cảnh trần spam: tối đa 10 DM mới/giờ/user (ADR-0070 mục 5).
  createdAt         DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  // GET /dms và đếm trần DM/giờ tra theo người gọi.
  @@index([userId])
}

/// Chặn người dùng (TG.9, ADR-0070): hai mức — chặn tạo DM mới và chặn tin mới trong DM có
/// sẵn; tin cũ vẫn đọc được. Một chiều nhưng kiểm tra theo cả hai chiều khi cho phép DM.
model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocksIssued", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  // Kiểm "tôi có bị ai chặn không" tra theo blockedId.
  @@index([blockedId])
}

/// Cài đặt người dùng (TG.13): giao diện + ngôn ngữ, đồng bộ mọi thiết bị. Cột tường minh
/// (không JSON blob) vì v0.2 là bộ cố định — thêm mục mới là một migration expand. Giá trị
/// do API kiểm (zod trong @ping/shared), kiểu String khớp cách `User.dmAllow` đặt tên nhánh.
/// DEFAULT dưới đây phải khớp `USER_SETTINGS_DEFAULTS` (cùng file shared) — đó là nguồn cho
/// GET lazy của API và store thiết bị của web.
/// Hàng tạo LAZY: GET khi chưa có hàng trả về mặc định ở tầng service, KHÔNG ghi — chỉ PATCH
/// mới upsert, tránh rác hàng cho user không bao giờ đụng settings.
model UserSettings {
  userId   String  @id @db.Uuid
  /// 'light' | 'dark' | 'system' — mặc định theo hệ điều hành (SETTINGS_THEMES).
  theme    String  @default("system")
  /// 'comfortable' | 'compact' (SETTINGS_DENSITIES).
  density  String  @default("comfortable")
  /// 'sm' | 'md' | 'lg' (SETTINGS_FONT_SIZES).
  fontSize String  @default("md")
  /// 'vi' | 'en' (SETTINGS_LOCALES).
  locale   String  @default("vi")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Prefs thông báo (TG.12): mức all/mentions/none + mute có hạn của MỘT user trên một
/// server hoặc một channel. Badge/notification do CLIENT tính từ prefs này + dữ liệu
/// unread sẵn có — server chỉ lưu và đọc lại (fetch khi client boot, không realtime).
/// `scope` kiểu String (không enum) khớp cách `Attachment.scope` đặt tên nhánh pipeline;
/// giá trị do API kiểm (zod). `level` tương tự — NOTIFY_LEVELS trong @ping/shared.
model NotificationPref {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  /// 'server' | 'channel'
  scope      String
  targetId   String    @db.Uuid
  level      String
  /// null = không mute; mốc trong quá khứ = hết mute (ngữ nghĩa của shouldNotify).
  mutedUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // FK tới user để xóa tài khoản là prefs chết theo (dữ liệu user-scoped). KHÔNG FK tới
  // Server/Channel: prefs sống khi target bị xóa — khi server/channel mất, hàng prefs trở
  // nên vô nghĩa nhưng VÔ HẠI (client không còn hỏi tới target đó) và dọn bằng nhánh dọn
  // riêng khi xóa server/channel; cố tình không thêm cascade/cleanup phức tạp ở đây.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Một dòng prefs duy nhất mỗi user mỗi target — chìa khóa upsert idempotent của PUT.
  @@unique([userId, scope, targetId])
  // GET /users/me/notification-prefs đọc mọi dòng của người gọi.
  @@index([userId])
}

model Message {
  id         String                   @id @default(uuid(7)) @db.Uuid
  channelId  String                   @db.Uuid
  authorId   String                   @db.Uuid
  content    String
  editedAt   DateTime?
  deletedAt  DateTime? // soft delete: moderation + đồng bộ realtime
  nonce      String? // idempotency key do client sinh (xem 16.1)
  // TG.22 (ADR-0067): loại tin — 'text' mặc định cho tin cũ (expand an toàn rolling deploy),
  // 'sticker' khi tin mang đúng một sticker (content rỗng, không kèm attachment tin nhắn).
  // Kiểu String (không enum) khớp cách `Attachment.scope` đặt tên nhánh pipeline.
  kind       String                   @default("text")
  // TG.22: sticker của tin; xóa cứng sticker (cascade từ gói khi server xóa) → SetNull,
  // tin cũ render khung "sticker đã bị xóa" theo deletedAt của Sticker còn theo id.
  stickerId  String?                  @db.Uuid
  // TG.25 (ADR-0069): tin GIF — URL + kích thước + nhà cung cấp chốt TẠI THỜI ĐIỂM GỬI là
  // nguồn sự thật (Tenor đổi link thì tin cũ hiển thị khối lỗi, chấp nhận như sticker bị
  // xóa). Không bảng riêng: GIF không phải tài sản của server — không trần, không quyền
  // riêng, không lifecycle; xóa tin là hết. Nullable nên expand an toàn rolling deploy.
  gifUrl      String?
  gifWidth    Int?
  gifHeight   Int?
  gifProvider String?
  // TG.1: reply trỏ tới tin gốc CÙNG channel (service kiểm); SetNull khi tin gốc bị xóa cứng.
  replyToId  String?                  @db.Uuid
  // TG.3 (ADR-0066): ghim. NULL ở pinnedAt = tin không được ghim; xóa mềm thì service gỡ ghim
  // trong cùng transaction nên trần 50 không tính tin đã xóa.
  pinnedAt   DateTime?
  pinnedById String?                  @db.Uuid
  // T4.6 (ADR-0045): cột sinh ở tầng SQL (migration fts_search):
  //   GENERATED ALWAYS AS (to_tsvector('simple', f_unaccent("content"))) STORED
  // Prisma không sinh được generated column nên chỉ khai báo kiểu để migrate diff khớp;
  // đọc/viết cột này chỉ qua $queryRaw trong SearchService, không qua client.
  search     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, f_unaccent(content))"))
  createdAt  DateTime                 @default(now())

  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // KHÔNG onDelete Cascade ở author: xóa user không được kéo sập tin nhắn.
  author   User      @relation(fields: [authorId], references: [id])
  // TG.1: quan hệ tự thân cho reply; soft-delete vẫn giữ liên kết để hiện "tin đã xóa".
  replyTo  Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  Message[] @relation("MessageReplies")
  // TG.3: người ghim gần nhất; xóa tài khoản không được kéo sập tin đã ghim.
  pinnedBy User?     @relation("MessagePins", fields: [pinnedById], references: [id], onDelete: SetNull)
  // TG.22: sticker của tin (null với tin văn bản); sticker bị xóa cứng → tin còn, preview mất.
  sticker  Sticker?  @relation(fields: [stickerId], references: [id], onDelete: SetNull)

  mentions  MessageMention[]
  reactions MessageReaction[]
  attachments Attachment[]

  // Chống ghi trùng khi client retry. Postgres cho phép NULL lặp trong unique
  // nên tin không có nonce không bao giờ bị block bởi index này.
  @@unique([channelId, authorId, nonce])
  // Index quan trọng nhất hệ thống: phân trang cursor (keyset) theo tin mới nhất.
  @@index([channelId, id(sort: Desc)])
  // FK SET NULL must locate replies without scanning the entire message history per deletion.
  @@index([replyToId])
  // TG.22: cùng lý do @@index([replyToId]) — SetNull của stickerId cần định vị nhanh.
  @@index([stickerId])
  // TG.3: danh sách ghim của một channel, mới ghim trước (trần 50 ở service).
  @@index([channelId, pinnedAt(sort: Desc)])
  // T4.6 (ADR-0045): FTS trên cột sinh `search` (index thật do migration fts_search tạo).
  @@index([search], type: Gin, map: "Message_search_key")
}

/// Cảm xúc trên tin (TG.2, ADR-0064): một user thả một emoji trên một tin đúng một lần.
/// Không soft-delete: gỡ = xóa hàng; tin bị xóa cứng thì cảm xúc đi theo (Cascade).
/// Durable quarantine/processing queue and quota reservations. Scope IDs survive
/// channel/user deletion so the worker can remove physical files afterwards.
model Attachment {
  id String @id @default(uuid(7)) @db.Uuid
  uploaderId String @db.Uuid
  // `message` scope (TG.6): channel + server bắt buộc. `avatar`/`serverIcon` (TG.7): channel
  // luôn null; serverIcon mang serverId, avatar không thuộc server nào.
  channelId String? @db.Uuid
  serverId  String? @db.Uuid
  messageId String? @db.Uuid
  /// 'message' | 'avatar' | 'serverIcon' (TG.7). Mặc định 'message' cho các hàng cũ.
  scope String @default("message")
  /// Thời điểm avatar/icon được gắn vào hồ sơ/server: một tệp hồ sơ chỉ gắn một lần (TG.7).
  boundAt DateTime?
  nonce String @db.Uuid
  filename String
  sizeBytes Int
  quotaBytes Int
  rawRemoved Boolean @default(false)
  nextRetryAt DateTime @default(now())
  mime String @default("application/octet-stream")
  width Int?
  height Int?
  status String @default("pending")
  createdAt DateTime @default(now())
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  // TG.22: sticker duy nhất dùng tệp này (claim một-lần qua `boundAt`).
  sticker Sticker?
  // TG.24: custom emoji duy nhất dùng tệp này.
  customEmoji CustomEmoji?

  @@unique([uploaderId, nonce])
  @@index([uploaderId, status])
  @@index([serverId, status])
  @@index([status, createdAt])
  @@index([messageId])
  @@index([scope, status])
}

/// Gói sticker (TG.22, ADR-0067). `serverId` NULL = gói hệ thống do dự án cung cấp (seed,
/// tài sản tự vẽ — nguồn giấy phép trong ASSETS_LICENSES.md); gói của server thì cascade
/// theo server. Sticker KHÔNG có serverId riêng: server suy qua pack, tệp dọn theo
/// `Attachment.scope='sticker'` như avatar (ADR-0067).
model StickerPack {
  id       String  @id @default(uuid(7)) @db.Uuid
  serverId String? @db.Uuid
  name     String
  position Int     @default(0)

  server   Server?   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  stickers Sticker[]

  // Danh sách gói của một server (mỗi server chỉ có một gói được tạo ngầm) + seed hệ thống.
  @@index([serverId, position])
}

/// Một sticker (TG.22, ADR-0067). Soft-delete: tin cũ cần biết sticker từng tồn tại để
/// render khung "sticker đã bị xóa". `createdBy` là cột trần (không FK) như
/// `Attachment.uploaderId` — metadata còn nguyên kể cả khi tài khoản bị xóa.
model Sticker {
  id           String    @id @default(uuid(7)) @db.Uuid
  packId       String    @db.Uuid
  name         String
  /// Thẻ tìm kiếm không dấu do client tự fold khi lọc.
  tags         String[]
  /// Tệp WebP đã kiểm định; một tệp chỉ tạo được một sticker (unique + boundAt).
  attachmentId String    @unique @db.Uuid
  createdBy    String    @db.Uuid
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  pack       StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  attachment Attachment  @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  messages   Message[]

  // Picker quản trị hiển thị theo thứ tự tạo; trần 30 giữ ở service (advisory lock).
  @@index([packId, deletedAt, createdAt])
}

/// Emoji tùy chỉnh theo server (TG.24, ADR-0068): tên token `:ten:<id>` trong tin, `c:<id>`
/// trong reaction. Soft-delete để tin cũ render placeholder; trần 50 tĩnh + 50 động giữ ở
/// service (advisory lock). `createdBy` cột trần như Attachment.uploaderId.
model CustomEmoji {
  id           String    @id @default(uuid(7)) @db.Uuid
  serverId     String    @db.Uuid
  name         String
  /// Ảnh động được giữ lại (worker reencode WebP động) — trần 50/50 tính theo cờ này.
  animated     Boolean   @default(false)
  attachmentId String    @unique @db.Uuid
  createdBy    String    @db.Uuid
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  server     Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@index([serverId, deletedAt, createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  /// Emoji Unicode đã qua allowlist ở API (tối đa 32 ký tự).
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Idempotent: thả lại cùng emoji không tạo hàng thứ hai.
  @@unique([messageId, userId, emoji])
  /// Tổng hợp count theo emoji cho một trang tin.
  @@index([messageId, emoji])
  /// Cờ "của tôi" theo người xem.
  @@index([messageId, userId])
}

/// Lịch sử hành động nhạy cảm (CLAUDE.md quy tắc 11): chỉ ghi thêm, không sửa/xóa.
/// Không có khóa ngoại: bản ghi phải còn nguyên kể cả khi server/role/tin nhắn bị xóa
/// (chính việc xóa server cũng là một hành động được ghi lại).
model AuditLog {
  id        String      @id @default(uuid(7)) @db.Uuid
  serverId  String      @db.Uuid
  actorId   String      @db.Uuid
  action    AuditAction
  targetId  String?     @db.Uuid
  metadata  Json?
  requestId String?
  createdAt DateTime    @default(now())

  // Xem lịch sử của một server, mới nhất trước.
  @@index([serverId, id(sort: Desc)])
}

/// Outbox cho sự kiện realtime (ADR-0033, T1.3): ghi cùng transaction với thay đổi dữ liệu,
/// relay worker phát lên Redis Stream sau đó. Consumer phải idempotent theo `id`.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String
  aggregateId   String?   @db.Uuid
  type          String
  payload       Json
  publishedAt   DateTime?
  attempts      Int       @default(0)
  nextRetryAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  // Quét relay: WHERE publishedAt IS NULL AND nextRetryAt <= now() ORDER BY createdAt.
  @@index([publishedAt, nextRetryAt, createdAt])
}

/// T5.7: tổng hợp chi phí/token AI theo user/ngày (UTC) cho quota + kill-switch ngân sách
/// (ADR-0047). Chỉ số liệu, không chứa prompt/nội dung tin nhắn. Không có khoá ngoại để giữ
/// số liệu chi phí khi user bị xoá (cùng lý do với AuditLog).
model AiUsage {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @db.Uuid
  day              DateTime @db.Date
  requests         Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(12, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Mỗi user chỉ có một bản ghi cho mỗi ngày; ghi bằng upsert + increment.
  @@unique([userId, day])
  // Kill-switch đọc tổng chi phí toàn hệ thống theo ngày.
  @@index([day])
}

enum AuditAction {
  ROLE_CREATE
  ROLE_UPDATE
  ROLE_DELETE
  MEMBER_ROLES_UPDATE
  MEMBER_KICK
  MESSAGE_DELETE
  CHANNEL_DELETE
  CHANNEL_UPDATE
  SERVER_DELETE
  SERVER_UPDATE
  SERVER_INVITE_REGENERATE
  MESSAGE_PIN
  MESSAGE_UNPIN
  STICKER_DELETE
  EMOJI_DELETE
  SERVER_BAN
  SERVER_UNBAN
  // TG.10: sắp xếp lại category / di chuyển channel sang nhóm khác.
  CHANNEL_REORDER
}
