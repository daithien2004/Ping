{
  "name": "web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gen:theme": "node scripts/gen-theme-css.mjs",
    "predev": "node scripts/gen-theme-css.mjs",
    "prebuild": "node scripts/gen-theme-css.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:visual": "pnpm --filter api build && pnpm --filter web build",
    "pretest:visual": "pnpm build:visual",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "pretest:visual:update": "pnpm build:visual",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "check:bundle": "node scripts/bundle-budget.mjs && node scripts/bundle-routes.mjs",
    "audit:design": "node scripts/design-audit.mjs"
  },
  "dependencies": {
    "@casl/ability": "7.0.2",
    "@casl/react": "7.0.1",
    "@ping/shared": "workspace:*",
    "@sentry/browser": "11.8.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-virtual": "3.14.21",
    "antd": "6.6.7",
    "cn": "0.4.0",
    "dayjs": "1.11.23",
    "lucide-react": "1.52.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.4",
    "use-intl": "4.14.9",
    "zod": "4.6.7",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@ping/eslint-config": "workspace:*",
    "@ping/tsconfig": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.26.0"
}
