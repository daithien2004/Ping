# Copy thành apps/web/.env.local khi cần đổi giá trị (Next đọc .env trong apps/web, không phải ở gốc repo).
# Địa chỉ API (REST và Socket.IO dùng chung cổng). Dev không đặt thì mặc định http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Sentry DSN của web (NEXT_PUBLIC_ = lộ ra trình duyệt, đó là bình thường với DSN). Trống = tắt hẳn.
NEXT_PUBLIC_SENTRY_DSN=
