{
  "name": "ping",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:studio": "pnpm --filter api prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "eslint --config apps/api/eslint.config.mjs --fix"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --config apps/web/eslint.config.mjs --fix"
    ],
    "**/*.{ts,tsx,js,mjs,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.22.0",
    "pnpm": "10.26.0"
  }
}
