{
  "uid": "ping-ai",
  "title": "Ping - AI observability",
  "tags": ["ping", "ai"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Daily AI spend (UTC)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ping-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ai_daily_spent_usd{job=\"ping-api\"} and on(job, instance) (ai_budget_metrics_up{job=\"ping-api\"} == 1))",
          "legendFormat": "{{outcome}}{{kind}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Daily budget (0 = disabled)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ping-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ai_daily_budget_usd{job=\"ping-api\"})",
          "legendFormat": "{{outcome}}{{kind}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Budget used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ping-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(ai_daily_spent_usd{job=\"ping-api\"} and on(job, instance) (ai_budget_metrics_up{job=\"ping-api\"} == 1)) / max(ai_daily_budget_usd{job=\"ping-api\"})) and (max(ai_daily_budget_usd{job=\"ping-api\"}) > 0)",
          "legendFormat": "{{outcome}}{{kind}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Budget collection healthy (1 = yes)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ping-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(ai_budget_metrics_up{job=\"ping-api\"})",
          "legendFormat": "{{outcome}}{{kind}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "AI requests by outcome / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ping-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(outcome) (rate(ai_requests_total{job=\"ping-api\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}{{kind}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "AI tokens / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ping-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
