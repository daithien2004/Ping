        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Estimated AI cost / hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ping-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_cost_usd_total{job=\"ping-api\"}[$__rate_interval])) * 3600",
          "legendFormat": "{{outcome}}{{kind}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "AI end-to-end p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ping-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(ai_latency_seconds_bucket{job=\"ping-api\"}[$__rate_interval])))",
