PORT=4000
DATABASE_URL=postgresql://ping:ping@localhost:5432/ping
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-only-placeholder-replace-with-64-random-chars-please-000000
WEB_ORIGIN=http://localhost:3000
# Số proxy đứng trước API (0 = chạy trực tiếp). Sau một load balancer: 1.
TRUST_PROXY=0
# Giới hạn thời gian lời gọi hạ tầng (ms), xem docs/adr/0026. Mặc định: 10000 và 1000.
PG_QUERY_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=1000
