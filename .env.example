PORT=4000
DATABASE_URL=postgresql://ping:ping@localhost:5432/ping
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-only-placeholder-replace-with-64-random-chars-please-000000
WEB_ORIGIN=http://localhost:3000
# Số proxy đứng trước API (0 = chạy trực tiếp). Sau một load balancer: 1.
TRUST_PROXY=0
# Giới hạn thời gian lời gọi hạ tầng (ms), xem docs/adr/0026. Mặc định: 10000 và 1000.
PG_QUERY_TIMEOUT_MS=10000
# S��` k���t n��`i t��?i �`a trong pool pg cho m��Tt instance API (T1.1). Ngân sA�ch: instance A- pool <= max_connections c��a Postgres + d��� phA�ng.
PG_POOL_MAX=10
# Cửa sổ gộp presence (ms) (ADR-0039). 0 = phát ngay (không gộp), dùng cho test.
PRESENCE_BATCH_MS=1000
REDIS_COMMAND_TIMEOUT_MS=1000
# Tắt êm khi nhận SIGTERM (ms). GRACE: /ready trả 503 nhưng vẫn nhận request cho LB kịp loại instance
# (production nên đặt ≥ 2 lần chu kỳ health check, ví dụ 10000). TIMEOUT: trần cho cả quá trình tắt.
SHUTDOWN_GRACE_MS=0
SHUTDOWN_TIMEOUT_MS=25000
# Cổng riêng cho GET /metrics (Prometheus). Trống = không mở. Chỉ cho mạng nội bộ, ví dụ 9464.
METRICS_PORT=
# Sentry DSN cho API. Trống = tắt hẳn.
SENTRY_DSN=

# AI (Phần 5). Groq free tier cho LLM; rỗng = AI tắt. Không commit khoá thật.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Embedding chạy cục bộ (không gọi API trả phí). Rỗng = `Xenova/multilingual-e5-small`.
EMBEDDING_MODEL=
# Qdrant local (docker compose). Rỗng = tính năng vector tắt.
QDRANT_URL=http://localhost:6333
# Indexer T5.3: cửa sổ tin liền trước cùng channel và trần token ước lượng mỗi chunk.
AI_CHUNK_WINDOW=4
AI_CHUNK_MAX_TOKENS=512
# Consumer indexer chạy trong API/worker; false = chỉ backfill thủ công.
AI_INDEXER_ENABLED=true
# Entry pending lâu hơn ngưỡng này (ms) được consumer mới nhận lại sau khi crash.
AI_INDEXER_CLAIM_IDLE_MS=30000
# T5.7/ADR-0047: hạn mức AI theo ngày (UTC). `AI_DAILY_REQUEST_LIMIT` là số lượt/user/ngày;
# `AI_DAILY_BUDGET_USD=0` tắt kill-switch ngân sách, > 0 là trần chi phí toàn hệ thống/ngày.
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_BUDGET_USD=1
# Giá quy đổi token → USD (free tier Groq = 0; đặt > 0 khi đổi provider trả phí).
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
# Cache câu trả lời theo (server, channel, khoảng tin, model, câu hỏi); 0 = tắt.
AI_CACHE_TTL_SECONDS=3600
# Timeout mỗi lần gọi LLM + retry có giới hạn (chỉ 429/5xx/lỗi mạng).
AI_LLM_TIMEOUT_MS=20000
AI_LLM_MAX_RETRIES=1
AI_LLM_RETRY_BACKOFF_MS=300
