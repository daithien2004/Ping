# Env mẫu cho stack production local. Trên VPS, deploy/bootstrap.sh sinh /opt/ping/.env.prod một lần.
# Không commit giá trị thật hoặc sao chép secrets production vào GitHub.
POSTGRES_PASSWORD=doi-thanh-mat-khau-dai-ngau-nhien
# Tạo bằng: openssl rand -hex 32  (tối thiểu 32 ký tự)
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
# Chỉ dùng tag local khi chạy stack trên máy phát triển.
GHCR_OWNER=local
IMAGE_TAG=local
# Local HTTP; web VÀ api cùng origin. Đổi URL phải build lại image web.
PUBLIC_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# HTTPS: thêm docker-compose.prod.tls.yml, PUBLIC_URL=https://localhost:8443,
# TLS_CERT_DIR trỏ tới thư mục chỉ chứa fullchain.pem và privkey.pem.
# Với VPS: PUBLIC_URL=https://20.193.75.48 (hoặc domain), BIND_ADDRESS=0.0.0.0,
# HTTP_PORT=80, HTTPS_PORT=443; cấp/gia hạn TLS bằng Certbot standalone trên VPS.
HTTPS_PORT=8443
# TLS_CERT_DIR=/absolute/path/to/certificates
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
