# Mẫu biến môi trường cho docker-compose.prod.example.yml. Sao chép thành .env.prod (đã bị git bỏ qua),
# KHÔNG commit giá trị thật. Production nên lấy bí mật từ secret manager của nơi triển khai.
POSTGRES_PASSWORD=doi-thanh-mat-khau-dai-ngau-nhien
# Tạo bằng: openssl rand -hex 32  (tối thiểu 32 ký tự)
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
# Local HTTP; web VÀ api cùng origin. Đổi URL phải build lại image web.
PUBLIC_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# HTTPS: thêm docker-compose.prod.tls.yml, PUBLIC_URL=https://localhost:8443,
# TLS_CERT_DIR trỏ tới thư mục có fullchain.pem và privkey.pem (không commit).
# Với domain thật: PUBLIC_URL=https://ping.example.com, BIND_ADDRESS=0.0.0.0,
# HTTP_PORT=80, HTTPS_PORT=443; tự quản lý cấp/gia hạn chứng chỉ rồi reload Nginx.
HTTPS_PORT=8443
# TLS_CERT_DIR=/absolute/path/to/certs
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
